{
  "manifest_version": 3,
  "name": "Promptify",
  "version": "2.0.1",
  "description": "Your AI usage, quantified. All data stored locally — no server required.",
  "icons": {
    "16":  "assets/icons/icon16.png",
    "48":  "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://chat.qwen.ai/*",
    "https://qianwen.com/*",
    "https://www.qianwen.com/*",
    "https://chat.deepseek.com/*",
    "https://deepseek.com/*",
    "https://kimi.ai/*",
    "https://www.kimi.ai/*",
    "https://kimi.moonshot.cn/*",
    "https://www.kimi.moonshot.cn/*",
    "https://kimi.com/*",
    "https://www.kimi.com/*",
    "https://copilot.microsoft.com/*",
    "https://copilot.cloud.microsoft/*",
    "https://m365copilot.com/*",
    "https://m365.cloud.microsoft/*",
    "https://grok.com/*",
    "https://www.grok.com/*",
    "https://labs.google/*",
    "https://flow.google/*",
    "https://notebooklm.google.com/*",
    "https://aistudio.google.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/platforms.js",
      "src/db.js",
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.qwen.ai/*",
        "https://qianwen.com/*",
        "https://www.qianwen.com/*",
        "https://chat.deepseek.com/*",
        "https://deepseek.com/*",
        "https://kimi.ai/*",
        "https://www.kimi.ai/*",
        "https://kimi.moonshot.cn/*",
        "https://www.kimi.moonshot.cn/*",
        "https://kimi.com/*",
        "https://www.kimi.com/*",
        "https://copilot.microsoft.com/*",
        "https://copilot.cloud.microsoft/*",
        "https://m365copilot.com/*",
        "https://m365.cloud.microsoft/*",
        "https://grok.com/*",
        "https://www.grok.com/*",
        "https://labs.google/*",
        "https://flow.google/*",
        "https://notebooklm.google.com/*",
        "https://aistudio.google.com/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "promptify@example.com",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "pages/popup/popup.html",
    "default_icon": {
      "16":  "assets/icons/icon16.png",
      "48":  "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  }
}
